+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+use std::fs::File;
+use std::io::{self, Read};
+use std::path::Path;
+
+const FIRMWARE_LOG: &str = "/sys/kernel/security/tpm0/binary_bios_measurements";
+const SYSTEMD_LOG: &str = "/run/log/systemd/tpm2-measure.log";
+const MAX_LOG_BYTES: u64 = 64 * 1024 * 1024;
+
+fn read_log(path: &Path) -> io::Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    File::open(path)
+        .and_then(|file| file.take(MAX_LOG_BYTES + 1).read_to_end(&mut bytes))
+        .map_err(|err| io::Error::new(err.kind(), format!("{}: {err}", path.display())))?;
+    if bytes.len() as u64 > MAX_LOG_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("{} exceeds event-log size limit", path.display()),
+        ));
+    }
+    Ok(bytes)
+}
+
+pub(super) fn collect_linux_logs(selected_pcrs: &[u32]) -> io::Result<Vec<u8>> {
+    let firmware = read_log(Path::new(FIRMWARE_LOG))?;
+    let userspace = match read_log(Path::new(SYSTEMD_LOG)) {
+        Ok(bytes) => bytes,
+        Err(err) if err.kind() == io::ErrorKind::NotFound => {
+            tracing::info!(target: "guest_attest", path = SYSTEMD_LOG,
+                "No systemd userspace log; firmware replay must still match quoted PCRs");
+            Vec::new()
+        }
+        Err(err) => return Err(err),
+    };
+    let combined =
+        azure_tpm::event_log::supplement_systemd_events(&firmware, &userspace, selected_pcrs)?;
+    tracing::info!(target: "guest_attest", firmware_bytes = firmware.len(),
+        userspace_bytes = userspace.len(), combined_bytes = combined.len(),
+        "Collected firmware plus genuine systemd measurement evidence");
+    Ok(combined)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn missing_firmware_path_is_an_explicit_error() {
+        let path = std::env::temp_dir().join(format!("missing-tcg-log-{}", std::process::id()));
+        let error = read_log(&path).unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::NotFound);
+        assert!(error.to_string().contains("missing-tcg-log"));
+    }
+
+    #[test]
+    fn unreadable_path_is_not_an_empty_log() {
+        assert!(read_log(&std::env::temp_dir()).is_err());
+    }
+}
