+/// Append genuine systemd phase records as TCG2 EV_IPL entries.
+///
+/// Firmware bytes are preserved. Only selected PCRs are supplemented; unsupported
+/// selected userspace measurements fail instead of being silently discarded.
+pub fn supplement_systemd_events(
+    firmware: &[u8],
+    userspace: &[u8],
+    selected_pcrs: &[u32],
+) -> io::Result<Vec<u8>> {
+    let firmware_log = parse_event_log_with_event1_spec(firmware)?;
+    let spec = firmware_log
+        .events
+        .first()
+        .and_then(|event| try_parse_spec_id_event(&event.event_data))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "Missing TCG2 Spec ID event"))?;
+    if spec.spec_version_major < 2 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "Systemd supplementation requires TCG2",
+        ));
+    }
+    let mut combined = firmware.to_vec();
+    if userspace.iter().all(u8::is_ascii_whitespace) {
+        return Ok(combined);
+    }
+    if userspace.iter().find(|byte| !byte.is_ascii_whitespace()) != Some(&0x1e) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "Expected systemd JSON sequence",
+        ));
+    }
+    for (index, record) in userspace.split(|byte| *byte == 0x1e).enumerate() {
+        if record.iter().all(u8::is_ascii_whitespace) {
+            continue;
+        }
+        let parsed: JsonTextEvent = serde_json::from_slice(record).map_err(|err| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!("Systemd record {index}: {err}"),
+            )
+        })?;
+        if parsed.pcr > 23 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "Invalid systemd PCR index",
+            ));
+        }
+        if !selected_pcrs.contains(&parsed.pcr) {
+            continue;
+        }
+        let content = parsed.content.as_ref().ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                "Missing systemd measurement content",
+            )
+        })?;
+        if parsed.content_type.as_deref() != Some("systemd")
+            || parsed.pcr != 11
+            || content.get("eventType").and_then(serde_json::Value::as_str) != Some("phase")
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!(
+                    "Unsupported selected systemd measurement at PCR {}",
+                    parsed.pcr
+                ),
+            ));
+        }
+        let phase = content
+            .get("string")
+            .and_then(serde_json::Value::as_str)
+            .ok_or_else(|| {
+                io::Error::new(io::ErrorKind::InvalidData, "Missing measured phase string")
+            })?;
+        if phase.len() > MAX_EVENT_DATA_SIZE
+            || parsed.digests.is_empty()
+            || parsed.digests.len() > MAX_DIGEST_COUNT as usize
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "Invalid systemd event size",
+            ));
+        }
+        let mut digests = BTreeMap::new();
+        for entry in parsed.digests {
+            let alg = PcrAlgorithm::from_str(&entry.hash_alg).map_err(|err| {
+                io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    format!("Unsupported recorded bank: {err}"),
+                )
+            })?;
+            let digest = hex::decode(&entry.digest).map_err(|err| {
+                io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    format!("Invalid recorded digest: {err}"),
+                )
+            })?;
+            let expected = match alg {
+                PcrAlgorithm::Sha1 => crate::crypto::sha1_concat(&[phase.as_bytes()]),
+                PcrAlgorithm::Sha256 => crate::crypto::sha256_concat(&[phase.as_bytes()]),
+                PcrAlgorithm::Sha384 => crate::crypto::sha384_concat(&[phase.as_bytes()]),
+            };
+            if digest != expected
+                || !spec.algorithms.iter().any(|bank| {
+                    bank.algorithm_id == alg.to_alg_id()
+                        && usize::from(bank.digest_size) == digest.len()
+                })
+                || digests.insert(alg.to_alg_id(), digest).is_some()
+            {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "Systemd digest mismatch, undeclared or duplicate bank",
+                ));
+            }
+        }
+        combined.extend_from_slice(&parsed.pcr.to_le_bytes());
+        combined.extend_from_slice(&0x0000_000Du32.to_le_bytes());
+        combined.extend_from_slice(&(digests.len() as u32).to_le_bytes());
+        for (algorithm, digest) in digests {
+            combined.extend_from_slice(&algorithm.to_le_bytes());
+            combined.extend_from_slice(&digest);
+        }
+        combined.extend_from_slice(&(phase.len() as u32).to_le_bytes());
+        combined.extend_from_slice(phase.as_bytes());
+    }
+    Ok(combined)
+}
+
+/// Check static SHA-256 PCR replay and the quote's selected-PCR digest.
+///
+/// A changing PCR/log snapshot returns WouldBlock so one-shot callers can
+/// recollect evidence with a bounded retry. This does not verify the AK signature.
+pub fn validate_sha256_quote_and_log(
+    log: &[u8],
+    quote: &[u8],
+    pcr_values: &[(u32, Vec<u8>)],
+) -> io::Result<()> {
+    let events = parse_event_log_with_event1_spec(log)?;
+    let replay = replay_pcrs(&events.events, PcrAlgorithm::Sha256);
+    if quote.get(..4) != Some(&[0xff, 0x54, 0x43, 0x47]) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "Invalid TPM quote magic",
+        ));
+    }
+    let parsed = crate::types::parse_quote_attestation(quote)?;
+    if parsed.pcr_selections.len() != 1
+        || parsed.pcr_selections[0].hash_alg != PcrAlgorithm::Sha256.to_alg_id()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "Expected one SHA-256 quote bank",
+        ));
+    }
+    let selection = &parsed.pcr_selections[0];
+    let quoted: Vec<u32> = (0..24)
+        .filter(|index| selection.select[(index / 8) as usize] & (1 << (index % 8)) != 0)
+        .collect();
+    let values: BTreeMap<u32, &[u8]> = pcr_values
+        .iter()
+        .map(|(index, digest)| (*index, digest.as_slice()))
+        .collect();
+    if values.len() != pcr_values.len()
+        || quoted != values.keys().copied().collect::<Vec<_>>()
+        || values.values().any(|value| value.len() != 32)
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "PCR values do not match quote selection",
+        ));
+    }
+    let zero = [0u8; 32];
+    let mut aggregate = Vec::new();
+    for index in quoted {
+        // Dynamic PCR reset state is not reconstructible from the firmware log.
+        if index < 16 && replay.get(&index).map(Vec::as_slice).unwrap_or(&zero) != values[&index] {
+            return Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                format!("SHA-256 PCR {index} does not match event-log replay; recollect evidence"),
+            ));
+        }
+        aggregate.extend_from_slice(values[&index]);
+    }
+    if parsed.pcr_digest != crate::crypto::sha256_concat(&[&aggregate]) {
+        return Err(io::Error::new(
+            io::ErrorKind::WouldBlock,
+            "PCR values changed while quoting; recollect evidence",
+        ));
+    }
+    Ok(())
+}
